" vim: filetype=vifm :

" Settings
set syscalls
" Keep deletion recoverable and open executables in the editor.
set trash
set norunexec
set history=100
set nofollowlinks
set sortnumbers
set vimhelp

colorscheme onedark
set timefmt=%m/%d\ %H:%M
set wildmenu
set wildstyle=popup
set suggestoptions=normal,visual,view,otherpane,keys,marks,registers
set ignorecase
set smartcase
set nohlsearch
set incsearch
set scrolloff=4
set statusline="  Hint: %z%= %A %10u:%-7g %15s %20d  "

" Remember directories, histories, layout, registers, and bookmarks.
set vifminfo=dhistory,savedirs,chistory,state,tui,shistory,
    \phistory,fhistory,dirstack,registers,bookmarks,bmarks

" Bookmarks
mark b ~/bin/
mark h ~/

" Commands
command! df df -h %m 2> /dev/null
command! diff vim -d %f %F
command! zip zip -r %c.zip %f
command! run !! ./%c
command! make !!make %a
command! mkcd :mkdir %a | cd %a
command! vgrep vim "+grep %a"
command! reload :write | restart

" Associations and previews
" Use desktop associations for documents and images; unknown files use Vim.
filextype *.pdf,*.ps,*.eps,*.ps.gz,*.djvu,*.html,*.htm,
         \*.bmp,*.jpg,*.jpeg,*.png,*.gif,*.xpm,*.webp,*.svg,
         \*.odt,*.doc,*.docx,*.xls,*.xlsx,*.odp,*.ppt,*.pptx,
         \*.ora,*.vym,*.torrent,*.pro,*.iso xdg-open %c %i &
filextype */ xdg-open %c %i &
filetype *.html,*.htm lynx %c

fileviewer *.pdf pdftotext -nopgbrk %c -
fileviewer *.bmp,*.jpg,*.jpeg,*.png,*.gif,*.xpm,*.webp,*.svg identify %c
fileviewer *.doc catdoc %c

filetype *.wav,*.mp3,*.flac,*.m4a,*.wma,*.ape,*.ac3,*.og[agx],*.spx,*.opus
       \ ffplay -nodisp -autoexit %c
filextype *.avi,*.mp4,*.wmv,*.dat,*.3gp,*.ogv,*.mkv,*.mpg,*.mpeg,*.vob,
         \*.fl[icv],*.m2v,*.mov,*.webm,*.mts,*.m4v,*.r[am],*.qt,*.divx,
         \*.as[fx] ffplay -fs -autoexit %c
fileviewer *.wav,*.mp3,*.flac,*.m4a,*.wma,*.ape,*.ac3,*.og[agx],*.spx,*.opus,
          \*.avi,*.mp4,*.wmv,*.dat,*.3gp,*.ogv,*.mkv,*.mpg,*.mpeg,*.vob,
          \*.fl[icv],*.m2v,*.mov,*.webm,*.mts,*.m4v,*.r[am],*.qt,*.divx,
          \*.as[fx] ffprobe -pretty %c 2>&1

filetype *.o nm %f | less
filetype *.[1-8] man ./%c
fileviewer *.[1-8] man ./%c | col -b

filetype *.md5 md5sum -c %f %S
filetype *.sha1 sha1sum -c %f %S
filetype *.sha256 sha256sum -c %f %S
filetype *.sha512 sha512sum -c %f %S
filetype *.asc !!gpg --verify %c

" Archive contents are the default action; extraction is available via :file.
filetype *.zip,*.jar,*.war,*.ear,*.oxt,*.apkg
       \ {View contents} unzip -l %c | less,
       \ {Extract here} unzip %c
fileviewer *.zip,*.jar,*.war,*.ear,*.oxt,*.apkg unzip -l %c
filetype *.tar,*.tar.bz2,*.tbz2,*.tgz,*.tar.gz,*.tar.xz,*.tar.txz,*.txz
       \ {View contents} tar -tf %c | less,
       \ {Extract here} tar -xf %c
fileviewer *.tar,*.tar.bz2,*.tbz2,*.tgz,*.tar.gz,*.tar.xz,*.tar.txz,*.txz
         \ tar -tf %c
filetype *.rar,*.7z
       \ {View contents} 7z l %c | less,
       \ {Extract here} 7z x %c
fileviewer *.rar,*.7z 7z l %c

" .ssh files contain the sshfs connection parameters on their first line.
filetype *.ssh FUSE_MOUNT2|sshfs %PARAM %DESTINATION_DIR %FOREGROUND

" Mappings
nnoremap s :shell<cr>
nnoremap S :sort<cr>
nnoremap w :view<cr>
vnoremap w :view<cr>gv
nnoremap gb :file &<cr>l

" Copy paths without a trailing newline; prefer Wayland in Wayland sessions.
if $WAYLAND_DISPLAY != '' && executable('wl-copy')
    nnoremap yd :!printf '%%s' %d | wl-copy %i<cr>
    nnoremap yf :!printf '%%s' %c:p | wl-copy %i<cr>
elseif executable('xclip')
    nnoremap yd :!printf '%%s' %d | xclip -selection clipboard %i<cr>
    nnoremap yf :!printf '%%s' %c:p | xclip -selection clipboard %i<cr>
elseif executable('xsel')
    nnoremap yd :!printf '%%s' %d | xsel --clipboard --input %i<cr>
    nnoremap yf :!printf '%%s' %c:p | xsel --clipboard --input %i<cr>
endif

nnoremap I cw<c-a>
nnoremap cc cw<c-u>
nnoremap A cw
nnoremap ,t :!kitty %i &<cr>
nnoremap ,c :write | edit $MYVIFMRC | restart<cr>
nnoremap ,w :set wrap!<cr>

nnoremap <f3> :!less %f<cr>
nnoremap <f4> :edit<cr>
nnoremap <f5> :copy<cr>
nnoremap <f6> :move<cr>
nnoremap <f7> :mkdir<space>
nnoremap <f8> :delete<cr>
